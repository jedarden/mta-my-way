# Dependencies
node_modules/

# Build outputs
dist/
*.tsbuildinfo

# Bundle analysis report (`BUNDLE_ANALYZE=1 npm run build` in packages/web)
bundle-report.html

# Environment
.env
.env.local
.env.*.local

# Database
*.db
*.db-journal
*.sqlite
*.sqlite-journal

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Test
coverage/

# VAPID keys (generated locally, set via env vars in production)
packages/server/data/vapid-keys.json

# Cache
.cache/
.npm/
.gtfs-cache/
~
__pycache__/

# Test runner output
test-results/

# Lighthouse CI reports (generated by `npm run lighthouse`)
.lighthouseci/

# Needle worker state (runtime artifacts)
.needle/.beads/.bf_history/

# NEEDLE execution traces are local diagnostics.
**/.beads/traces/

# Checkpoint object chunks are regenerable from the live store (SQLite is
# authoritative; current.json/previous.json point at them but the repo has
# never intentionally tracked them). Their archived bead-note prose trips the
# Forgejo pre-receive secret scanner, so any commit that sweeps them in is
# unpushable — see docs/notes/2026-09-13-shipped-work-gate-repair.md.
**/.beads/checkpoint/objects/

# Local NEEDLE and bead runtime state
.needle-predispatch-sha
.beads/events.jsonl
.beads/heartbeats.jsonl
.beads/diagnostics/
.beads/logs/
.beads/traces/
.beads/receipts/
.beads/*.db
.beads/*.db-shm
.beads/*.db-wal
.beads/*.db.backup.*
.beads/*.lock
.beads/*.tmp
.beads/*.temp
.beads/*.journal
.br_recovery/
